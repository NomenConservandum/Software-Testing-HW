# Базовые настройки стенда
BASE_URL=https://www.udacha-market.ru
CATALOG_PATH=/catalog/napolnye_pokrytiya/linoleum/

# Учётные данные существующего тестового аккаунта (в репозитории не хранить!)
AUTH_LOGIN=
AUTH_PASSWORD=

# Опциональный второй способ входа (если аккаунт допускает вход по телефону или нужен отдельный логин)
AUTH_PHONE=

# Настройки браузера и таймаутов
BROWSER=chromium
# Путь к системному браузеру (например /usr/bin/chromium). Оставьте пустым, чтобы использовать встроенный браузер Playwright
BROWSER_EXECUTABLE_PATH=/usr/bin/chromium
HEADLESS=true
TIMEOUT_MS=15000

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Сквозной сценарий (e2e): целевой товар раздела "Линолеум"
SEARCH_QUERY=Avanta Karuzo 4
PRODUCT_URL=/catalog/napolnye_pokrytiya/linoleum/linoleum_2_0m/482839/
EXPECTED_PRODUCT_NAME=Линолеум 2,0м Avanta Karuzo 4
EXPECTED_PRODUCT_ARTICLE=14823
EXPECTED_PRODUCT_PRICE=450

# Если true --- нажимает "Оформить заказ" (наложенный платёж / самовывоз) и проверяет номер созданного заказа.
# Если false --- доходит до полностью заполненной формы оформления без реальной отправки заказа.
E2E_SUBMIT_ORDER=false
